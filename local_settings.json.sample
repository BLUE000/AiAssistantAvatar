{
  # ---------------------------------------------------------------------------
  # AI アシスタント アバター 設定ファイル サンプル (local_settings.json.sample)
  # ※ このファイルを local_settings.json にリネームまたはコピーしてご使用ください。
  # ---------------------------------------------------------------------------

  # メインで使用する AI プロバイダ ("groq", "gemini", "mistral", "huggingface", "openrouter", "sakura", "dummy")
  "ai_provider": "mistral",

  # 各プロバイダの API キー設定
  "mistral_api_key": "YOUR_MISTRAL_API_KEY_HERE",
  "groq_api_key": "gsk_YOUR_GROQ_API_KEY_HERE",
  "gemini_api_key": "AIzaSy_YOUR_GEMINI_API_KEY_HERE",
  "huggingface_api_key": "hf_YOUR_HUGGINGFACE_API_KEY_HERE",
  "openrouter_api_key": "sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE",
  "sakura_api_key": "YOUR_SAKURA_API_KEY_HERE",

  # 各プロバイダの使用モデル指定（空文字の場合は最新推奨モデルを自動選択）
  "mistral_model": "mistral-small-latest",
  "groq_model": "llama-3.3-70b-versatile",
  "gemini_model": "gemini-2.5-flash",

  # マネージャー AI 設定 (マルチAI協調機能)
  "manager_ai_enabled": false,
  "manager_ai_provider": "groq",
  "manager_ai_model": "llama-3.1-8b-instant",

  # 各種機能設定
  "trans_cipher_key": "AiAssistantAvatar",
  "blacklist_enabled": true,

  # 音声入力の無音タイムアウト時間（ミリ秒指定。指定時間を経過するとウェイクワード待機へ復帰）
  "voice_silence_timeout_ms": 1000,

  # 音声入力時にアバター名（ぶるたろう 等）に反応するかどうか (true: 反応する, false: 反応しない)
  "voice_name_reaction_enabled": true,

  # 音声入力時にウェイクワード（AIアシスタント 等）に反応するかどうか (true: 反応する, false: 反応しない)
  "voice_wakeword_enabled": true,

  # 音声入力用ウェイクワード（省略時は twitch_wakeword の設定値を自動流用）
  "voice_wakeword": "AIアシスタント",

  # 棒読みちゃん (Bouyomi-chan) 音声読み上げ連携設定 (50001番ポート: TCPソケット通信, 50080番ポート: HTTP GET)
  "bouyomichan_enabled": false,
  "bouyomichan_url": "http://localhost:50001"
}
