{
  # ---------------------------------------------------------------------------
  # AI アシスタント アバター 設定ファイル サンプル (local_settings.json.sample)
  # ※ このファイルを local_settings.json にリネームまたはコピーしてご使用ください。
  # ---------------------------------------------------------------------------

  # メインで使用する AI プロバイダ ("groq", "cerebras", "mistral", "huggingface", "openrouter", "sakura", "dummy")
  "ai_provider": "mistral",

  # 各プロバイダの API キー設定
  "mistral_api_key": "YOUR_MISTRAL_API_KEY_HERE",
  "groq_api_key": "gsk_YOUR_GROQ_API_KEY_HERE",
  "cerebras_api_key": "csk-YOUR_CEREBRAS_API_KEY_HERE",
  "huggingface_api_key": "hf_YOUR_HUGGINGFACE_API_KEY_HERE",
  "openrouter_api_key": "sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE",
  "sakura_api_key": "YOUR_SAKURA_API_KEY_HERE",

  # 各プロバイダの使用モデル指定（空文字の場合は最新推奨モデルを自動選択）
  "mistral_model": "mistral-small-latest",
  "groq_model": "llama-3.3-70b-versatile",
  "cerebras_model": "llama-3.3-70b",

  # マネージャー AI 設定 (マルチAI協調機能)
  "manager_ai_enabled": false,
  "manager_ai_provider": "groq",
  "manager_ai_model": "llama-3.1-8b-instant",

  # 各種機能設定
  "trans_cipher_key": "AiAssistantAvatar",
  "blacklist_enabled": true
}
